<template>
    <SeoHead :seo="seo" />
    <section class="relative h-auto overflow-hidden">
        <NavBar text-color="text-black" background-color="bg-transparent"
            class=" z-20 w-full border-b-pink-600/10 shadow-sm shadow-black/10 backdrop-blur" />

        <Toaster :close-button="true" class="absolute" />
    </section>
    <main
        class="w-full relative bg-background mx-auto max-w-7xl px-4 flex flex-col items-start md:flex-row gap-8 py-8 md:py-8 sm:px-12 lg:px-16">
        <aside class="bg-background event-media w-full md:w-1/3 md:sticky md:top-4 z-10 space-y-8">
            <div v-if="event.cover_image_url"
                class="inset-0 flex flex-col w-full sm:w-8/12 md:w-full mx-auto overflow-hidden pointer-events-none">
                <div class="flex justify-end">
                    <span
                        class="inline-flex items-center absolute top-10 right-8 md:top-4 md:right-4 rounded-full px-2 py-1 text-sm font-medium backdrop-blur-xs"
                        :class="modernStatusClasses">
                        <span v-if="currentStatus === 'live'"
                            class="w-2 h-2 bg-red-400 rounded-full mr-2 animate-pulse"></span>
                        {{ currentStatus.charAt(0).toUpperCase() + currentStatus.slice(1) }}
                    </span>
                </div>
                <img :src="event.cover_image_url" :alt="event.title" class="w-full  rounded  object-cover" />
            </div>
            <!-- Action buttons section -->
            <div class="flex flex-row gap-4 justify-center">
                <Button v-if="!event.is_rsvp && canPurchaseTickets" @click="scrollToTickets"
                    class="bg-white text-slate-900 hover:bg-white/90 font-semibold px-6 py-3 rounded-full text-base">
                    Get Tickets
                </Button>
                <Button v-else-if="event.is_rsvp && canMakeRsvp" @click="scrollToRsvp"
                    class="bg-white text-slate-900 hover:bg-white/90 font-semibold px-6 py-3 rounded-full text-base">
                    RSVP Now
                </Button>
                <!-- <Button @click="copyLink" class="btn-bg px-6 py-3 rounded-full text-base ">
                    <LinkIcon class="w-5 h-5" />
                    Share
                </Button> -->
                <Button @click="showReportModal = true" variant="outline"
                    class="border-red-200 text-red-600 hover:bg-red-50 px-6 py-3 rounded-full text-base">
                    <AlertTriangle class="w-5 h-5" />
                    Report
                </Button>
            </div>
            <Link :href="route('organizers.show', event.organizer?.slug)"
                class="group hover:text-primary gap-2 hover:bg-primary/5 organizer border-border border-1 p-1 rounded bg-card flex sm:flex-row items-center justify-start">
            <div class="flex flex-row gap-2 w-full">
                <div class="img-box">
                    <img v-if="event?.organizer?.logo_url" :src="event.organizer.logo_url"
                        class="h-12 w-12 aspect-square object-cover rounded-sm" alt="organizer_logo">
                    <div v-else
                        class="h-12 w-12 aspect-square bg-primary rounded items-center flex justify-center text-white font-black text-2xl">
                        <span class="p-0 m-0">{{ event.organizer?.name.slice(0, 1) }}</span>
                    </div>
                </div>
                <div class="flex flex-col">
                    <p class="text-sm font-light text-foreground/80">Organized by</p>
                    <!-- <Link :href="route('organizers.show', event.organizer?.slug)"
                              class="hover:text-primary hover:underline transition-colors">
                            </Link> -->
                    <div class="flex flex-row justify-between w-full">
                        <p class="w-full">{{ event.organizer?.name }}</p>
                    </div>

                </div>
            </div>
            <!-- <ChevronRight class="mr-1" size = 48 /> -->
            <!-- <Link :href="route('organizers.show', event.organizer?.slug) + '#subscribe'"
                      class="btn-bg text-white px-2 py-1 rounded text-xs hover:opacity-90 transition-opacity">
                    Subscribe
                </Link> -->
            </Link>
            <article class="flex flex-col my-8">
                <article class="text-sm text-foreground/60" v-html="event.organizer?.description ?? ''"></article>
                <!-- {{ event.organizer }} -->
                <div class="flex flex-row gap-2 mt-4">
                    <!-- <div class="p-2 bg-primary/40 rounded w-8 h-8 text-foreground"> -->
                    <Globe class="w-6 h-6 text-foreground" />
                    <!-- </div> -->
                    <a v-if="event.organizer?.website" :href="event.organizer?.website" target="_blank"
                        class="hover:underline hover:text-primary">{{ event.organizer?.website }}</a>
                </div>
            </article>
        </aside>
        <!-- content -->
        <section class="content w-full md:w-2/3">
            <div class="lgb p-4 rounded-xl">
                <!-- Event title with modern typography -->
                <h1 class="text-xl md:text-3xl lg:text-4xl xl:text-5xl font-bold text-foreground leading-tight mb-8">
                    {{ event.title }}
                </h1>

                <!-- Event details in horizontal layout for larger screens -->
                <div class="grid grid-cols-1 gap-2 max-w-5xl">
                    <!-- Date and Time -->
                    <div class="flex items-center gap-4">
                        <div
                            class="flex-shrink-0 w-12 h-12 rounded-full backdrop-blur-md border border-white/20 flex items-center justify-center">
                            <Calendar />
                        </div>
                        <div>
                            <!-- <h4 class="text-xs md:text-sm text-foreground uppercase tracking-wide font-bold">Date
                            </h4> -->
                            <div class="flex flex-wrap">
                                <p class="text-sm md:text-lg font-medium text-foreground inline">
                                    {{ formatDate(event.start_date) }}
                                </p>
                                <p v-if="event.end_date" class="text-sm md:text-lg font-medium text-foreground inline">
                                    &nbsp;- {{ formatDate(event.end_date) }}</p>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4">
                        <div
                            class="flex-shrink-0 w-12 h-12 rounded-full backdrop-blur-md border border-white/20 flex items-center justify-center">
                            <Clock3 />
                        </div>
                        <div>
                            <!-- <h4 class="text-xs md:text-sm text-foreground uppercase tracking-wide font-medium">Time
                            </h4> -->
                            <p class="text-foreground text-sm md:text-lg font-medium">
                                <template v-if="event.end_date && event.end_date !== event.start_date">
                                    Starts {{ formatTime(displayStartTime!) }}
                                </template>
                                <template v-else>
                                    {{ formatTime(displayStartTime!) }}
                                    <span v-if="displayEndTime"> - {{ formatTime(displayEndTime) }}</span>
                                </template>
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-4">
                        <div
                            class="flex-shrink-0 w-12 h-12 rounded-full backdrop-blur-md border border-white/20 flex items-center justify-center">
                            <Presentation />
                        </div>
                        <div>
                            <!-- <h4 class="text-sm md:text-lg font-medium text-foreground uppercase tracking-wide font-medium">Event Mode
                            </h4> -->
                            <p class="text-foreground text-sm md:text-lg font-medium">{{ event.mode?.toUpperCase() }}
                            </p>
                        </div>
                    </div>
                    <!-- Location -->
                    <div v-if="(event.mode !== 'online') && event.venue_name" class="flex items-center gap-4">
                        <div
                            class="flex-shrink-0 w-12 h-12 rounded-full backdrop-blur-md border border-white/20 flex items-center justify-center">
                            <MapPin />
                        </div>
                        <div>
                            <p class="text-sm md:text-lg font-medium text-foreground">{{ event.venue_name }}</p>
                            <p v-if="event.venue_address" class="text-foreground text-sm leading-relaxed line-clamp-3">
                                {{ event.venue_address }}
                            </p>
                        </div>
                    </div>
                    <!-- {{ event }} -->
                    <div v-if="(event.mode !== 'in-person') && event.online_link" class="flex items-center gap-4">
                        <div
                            class="flex-shrink-0 w-12 h-12 rounded-full backdrop-blur-md border border-white/20 flex items-center justify-center">
                            <LinkIcon />
                        </div>
                        <div>
                            <!-- <h4 class="text-xs md:text-sm text-foreground uppercase tracking-wide font-medium">Online Meeting Details
                            </h4> -->
                            <p class="text-sm md:text-lg font-medium text-foreground">{{ event.platform_name }}</p>
                            <div class="">
                                <a v-if="event.is_public_link"
                                    class="text-foreground text-sm md:text-lg font-medium leading-relaxed"
                                    :href="event.online_link" target="_blank">
                                    {{ event.online_link }}
                                </a>
                                <p v-else>{{ event.platform_name }} link will be shared after registration</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <!-- Event Description -->
            <div class="my-8 bg-background p-6 rounded">
                <h2 class="mb-4 text-xl font-semibold text-foreground">About This Event</h2>
                <hr>
                <div class="prose max-w-none">
                    <div v-if="event.description" v-html="event.description" class="leading-relaxed text-foreground/80">
                    </div>
                    <p v-else class="foreground/60 italic">No description available for this event.</p>
                </div>
            </div>

            <!-- Agenda -->
            <div v-if="(event.sessions && event.sessions.length) || (event.people && event.people.length)" class="mb-8 p-6 rounded">
                <h2 class="mb-4 text-xl font-semibold text-foreground">Agenda</h2>
                <hr class="mb-6">

                <!-- Day tabs (multi-day only) -->
                <div v-if="isMultiDay" class="flex flex-wrap gap-2 mb-6">
                    <button
                        v-for="(_, date) in sessionsByDate"
                        :key="date"
                        @click="activeDay = String(date)"
                        :class="[
                            'px-4 py-1.5 rounded text-sm font-medium transition-colors border',
                            activeDay === String(date)
                                ? 'bg-primary text-white border-primary'
                                : 'bg-transparent text-foreground/70 border-border hover:border-primary/40'
                        ]"
                    >
                        {{ date === 'unset' ? 'General' : formatDateShort(String(date)) }}
                    </button>
                </div>

                <!-- Sessions column -->
                <div v-if="event.sessions && event.sessions.length" class="space-y-4">
                    <div
                        v-for="session in activeSessions"
                        :key="session.id"
                        class="border border-border rounded-lg p-4"
                    >
                        <!-- Session info -->
                        <div class="flex flex-wrap items-center gap-2 mb-2">
                            <span class="inline-flex items-center gap-1.5 text-xs text-foreground/60 bg-muted px-2.5 py-1 rounded-full whitespace-nowrap">
                                <Clock3 class="w-3 h-3" />
                                {{ formatTime(session.start_time) }}
                                <template v-if="session.end_time"> – {{ formatTime(session.end_time) }}</template>
                            </span>
                            <span v-if="session.location" class="text-xs bg-muted text-muted-foreground px-2.5 py-1 rounded-full">
                                {{ session.location }}
                            </span>
                        </div>
                        <p class="font-semibold text-foreground text-sm leading-snug">{{ session.title }}</p>
                        <p v-if="session.description" class="text-xs text-foreground/60 mt-1 leading-relaxed">{{ session.description }}</p>

                        <!-- Speakers linked to this session -->
                        <div
                            v-if="activePeople.filter(p => p.session_id === session.id || p.session_id == null).length"
                            class="mt-3 pt-3 border-t border-border"
                        >
                            <p class="text-xs font-semibold uppercase tracking-widest text-foreground/40 mb-2">Speakers</p>
                            <div class="flex flex-wrap gap-3">
                                <div
                                    v-for="person in activePeople.filter(p => p.session_id === session.id || p.session_id == null)"
                                    :key="person.id"
                                    class="flex items-center gap-2"
                                >
                                    <div class="w-8 h-8 rounded-full overflow-hidden bg-muted flex items-center justify-center flex-shrink-0">
                                        <img v-if="person.photo_url" :src="person.photo_url" :alt="person.name" class="w-full h-full object-cover" />
                                        <span v-else class="text-xs font-bold text-muted-foreground">{{ person.name.charAt(0) }}</span>
                                    </div>
                                    <div>
                                        <p class="text-xs font-medium text-foreground leading-tight">{{ person.name }}</p>
                                        <p class="text-xs text-foreground/50 capitalize">{{ person.role }}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- People with no session (shown when no sessions exist) -->
                <div v-else-if="activePeople.length" class="space-y-3">
                    <p class="text-xs font-semibold uppercase tracking-widest text-foreground/40">Speakers & Guests</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div v-for="person in activePeople" :key="person.id" class="flex items-start gap-3 border border-border rounded-lg p-3">
                            <div class="w-10 h-10 rounded-full overflow-hidden bg-muted flex items-center justify-center flex-shrink-0">
                                <img v-if="person.photo_url" :src="person.photo_url" :alt="person.name" class="w-full h-full object-cover" />
                                <span v-else class="text-sm font-bold text-muted-foreground">{{ person.name.charAt(0) }}</span>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-foreground leading-tight">{{ person.name }}</p>
                                <p class="text-xs text-foreground/50 capitalize">{{ person.role }}</p>
                                <p v-if="person.bio" class="text-xs text-foreground/60 mt-1 leading-relaxed line-clamp-2">{{ person.bio }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Partners & Sponsors -->
            <div v-if="event.all_partners && event.all_partners.length" class="mb-8 p-6 rounded">
                <h2 class="mb-4 text-xl font-semibold text-foreground">Partners &amp; Sponsors</h2>
                <hr class="mb-6">

                <!-- Sponsors grouped by tier -->
                <template v-if="eventSponsors.length">
                    <p class="text-xs font-semibold uppercase tracking-widest text-foreground/40 mb-3">Sponsors</p>
                    <div class="flex flex-wrap gap-6 mb-6">
                        <a
                            v-for="sponsor in eventSponsors"
                            :key="sponsor.id"
                            :href="sponsor.website ?? undefined"
                            :target="sponsor.website ? '_blank' : undefined"
                            :rel="sponsor.website ? 'noopener noreferrer' : undefined"
                            class="flex flex-col items-center gap-2 group"
                            :class="{ 'pointer-events-none': !sponsor.website }"
                        >
                            <div class="w-20 h-20 rounded border border-border bg-muted flex items-center justify-center overflow-hidden">
                                <img v-if="sponsor.logo_url" :src="sponsor.logo_url" :alt="sponsor.name" class="w-full h-full object-contain p-2" />
                                <span v-else class="text-sm font-bold text-muted-foreground">{{ sponsor.name.charAt(0) }}</span>
                            </div>
                            <div class="text-center">
                                <p class="text-xs font-medium text-foreground group-hover:text-primary transition-colors leading-tight">{{ sponsor.name }}</p>
                                <p v-if="sponsor.tier" class="text-xs text-foreground/50 capitalize">{{ sponsor.tier }}</p>
                            </div>
                        </a>
                    </div>
                </template>

                <!-- Partners -->
                <template v-if="eventPartners.length">
                    <p class="text-xs font-semibold uppercase tracking-widest text-foreground/40 mb-3">Partners</p>
                    <div class="flex flex-wrap gap-6">
                        <a
                            v-for="partner in eventPartners"
                            :key="partner.id"
                            :href="partner.website ?? undefined"
                            :target="partner.website ? '_blank' : undefined"
                            :rel="partner.website ? 'noopener noreferrer' : undefined"
                            class="flex flex-col items-center gap-2 group"
                            :class="{ 'pointer-events-none': !partner.website }"
                        >
                            <div class="w-20 h-20 rounded border border-border bg-muted flex items-center justify-center overflow-hidden">
                                <img v-if="partner.logo_url" :src="partner.logo_url" :alt="partner.name" class="w-full h-full object-contain p-2" />
                                <span v-else class="text-sm font-bold text-muted-foreground">{{ partner.name.charAt(0) }}</span>
                            </div>
                            <p class="text-xs font-medium text-foreground group-hover:text-primary transition-colors leading-tight text-center">{{ partner.name }}</p>
                        </a>
                    </div>
                </template>
            </div>

            <!-- Ticket Purchase Form -->
            <div v-if="!event.is_rsvp" class="mb-8 lgb p-6 rounded" data-section="tickets">
                <!-- General Error Display -->
                <div v-if="errors.error" class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd"
                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                                    clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-red-800">Purchase Error</h3>
                            <p class="mt-1 text-sm text-red-700">{{ errors.error }}</p>
                        </div>
                    </div>
                </div>

                <!-- Ticket Availability Notice -->
                <div v-if="!canPurchaseTickets"
                    class=" rounded border border-orange-200 bg-orange-50/10 p-6 text-center">
                    <svg class="mx-auto h-12 w-12 text-orange-400" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-orange-900">{{ unavailabilityMessage }}</h3>
                    <p class="mt-1 text-sm text-orange-700">Please contact the Organizer for any assistance.</p>
                    <a v-if="event.organizer?.phone" :href="'tel:' + event.organizer?.phone" class="mt-4">Call
                        Organizer</a>
                </div>

                <div v-else class="space-y-6 form-section">
                    <!-- Ticket Selection -->
                    <div class="form-section">
                        <h2 class="mb-4 text-xl font-semibold">Select Tickets</h2>
                        <div v-if="availableTicketTypes.length === 0"
                            class="rounded border border-red-200 bg-red-50 p-6 text-center">
                            <svg class="mx-auto h-12 w-12 text-red-400" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <h3 class="mt-2 text-sm font-medium text-red-900">No tickets available for this event.
                            </h3>
                        </div>
                        <TicketSelector v-else :ticket-types="availableTicketTypes" @update="handleTicketSelection"
                            :disabled="!canPurchaseTickets" />
                    </div>

                    <!-- Quick Checkout -->
                    <div v-if="hasSelectedTickets" class="border-t pt-6 form-section">
                        <div class="">
                            <h3 class="text-lg font-semibold text-foreground mb-4">Quick Checkout</h3>

                            <!-- Order Summary -->
                            <div class="bg-whites rounded-lg p-4s mb-4">
                                <h4 class="font-medium text-foreground mb-3">Your Order</h4>
                                <div class="space-y-2">
                                    <div v-for="selection in ticketSelections" :key="selection.ticket_type_id"
                                        class="flex justify-between items-center">
                                        <div>
                                            <span
                                                class="font-medium">{{ getTicketTypeName(selection.ticket_type_id) }}</span>
                                            <span class="text-foreground/70 ml-2">× {{ selection.quantity }}</span>
                                        </div>
                                        <span class="font-semibold">GHS
                                            {{ (getTicketTypePrice(selection.ticket_type_id) * selection.quantity) }}</span>
                                    </div>
                                </div>

                                <!-- Discount Code -->
                                <div class="mt-4 pt-4 border-t border-gray-200">
                                    <div class="flex gap-2 mb-2">
                                        <Input v-model="discountCode" placeholder="Discount code (optional)"
                                            :disabled="validationDiscount.loading || !canPurchaseTickets"
                                            class="flex-1 text-sm rounded pri-borders" />
                                        <Button type="button" @click="validateDiscountCode"
                                            :disabled="!discountCode || validationDiscount.loading || !canPurchaseTickets"
                                            class="rounded pri-borders bg-primary">
                                            {{ validationDiscount.loading ? 'Applying...' : 'Apply' }}
                                        </Button>
                                    </div>

                                    <div v-if="validationDiscount.error" class="text-sm text-red-600">
                                        {{ validationDiscount.error }}
                                    </div>

                                    <div v-if="appliedDiscount"
                                        class="flex items-center justify-between text-sm text-green-600">
                                        <span>{{ appliedDiscount.name }} discount applied</span>
                                        <div class="flex items-center gap-2">
                                            <span>-GHS {{ appliedDiscount.amount }}</span>
                                            <Button type="button" @click="clearDiscount" variant="ghost" size="sm"
                                                class="cursor-pointer p-1 text-red-500 hover:text-red-700">
                                                ✕
                                            </Button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Total -->
                                <div class="mt-4 pt-4 border-t border-gray-200">
                                    <div v-if="appliedDiscount" class="flex justify-between text-sm text-foreground/70 mb-1">
                                        <span>Subtotal:</span>
                                        <span>GHS {{ subtotalAmount }}</span>
                                    </div>
                                    <div v-if="appliedDiscount"
                                        class="flex justify-between text-sm text-green-600 mb-2">
                                        <span>Discount:</span>
                                        <span>-GHS {{ appliedDiscount.amount }}</span>
                                    </div>
                                    <div class="flex justify-between items-center text-lg font-bold text-foreground">
                                        <span>Total:</span>
                                        <span>GHS {{ finalAmount }}</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Continue to Details Button -->
                            <div class="w-full text-center">
                                <Button @click="proceedToBuyerForm" :disabled="processing || !canPurchaseTickets"
                                    class="rounded cursor-pointer bg-primary cursor-pointer w-full py-5 md:w-1/2 mx-auto disabled:opacity-50 disabled:cursor-not-allowed">
                                    Continue - GHS {{ finalAmount }}
                                </Button>
                            </div>

                            <p class="text-xs text-foreground/70 text-center mt-3">
                                Next: Enter buyer and attendee information
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RSVP Form -->
            <div v-if="event.is_rsvp" class="mb-8 bg-backgrounds lgb rounded p-6" data-section="rsvp">

                <!-- Success message displayed after form submission -->
                <div v-if="rsvpSuccess" class="p-6">
                    <div class="border border-green-500 p-6 text-center bg-green-500/5 rounded-lg">
                        <svg class="mx-auto h-16 w-16 text-green-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <h3 class="text-xl font-bold text-green-700 mb-2">RSVP Confirmed!</h3>
                        <p class="text-green-700 font-medium">{{ rsvpSuccess }}</p>
                    </div>
                </div>

                <div v-else-if="!canMakeRsvp" class="rounded-lg border border-red-300 bg-red-50 p-6 text-center mb-6">
                    <div class="flex justify-center">
                        <div class="flex items-center justify-center w-16 h-16 bg-red-100 rounded-full mb-4">
                            <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L4.232 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                            </svg>
                        </div>
                    </div>
                    <h3 class="text-lg font-semibold text-red-900 mb-2">RSVP Unavailable</h3>
                    <p class="text-red-700">{{ unavailabilityMessage }}</p>
                    <div v-if="event.organizer?.email || event.organizer?.phone" class="mt-4 pt-4 border-t border-red-200">
                        <p class="text-sm text-red-600 mb-2">Need assistance? Contact the organizer:</p>
                        <div class="flex justify-center gap-4">
                            <a v-if="event.organizer?.email"
                               :href="'mailto:' + event.organizer.email"
                               class="inline-flex items-center px-3 py-2 text-sm font-medium text-red-700 bg-white border border-red-300 rounded-md hover:bg-red-50 transition-colors">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                </svg>
                                Email
                            </a>
                            <a v-if="event.organizer?.phone"
                               :href="'tel:' + event.organizer.phone"
                               class="inline-flex items-center px-3 py-2 text-sm font-medium text-red-700 bg-white border border-red-300 rounded-md hover:bg-red-50 transition-colors">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                </svg>
                                Call
                            </a>
                        </div>
                    </div>
                </div>
                <form v-else-if="canMakeRsvp && !rsvpSuccess" @submit.prevent="sendRsvp" class="space-y-6" id="rsvp-form">
                    <div v-if="errors.venue_full" class="mb-6 rounded border border-red-200 bg-red-50 p-4">
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd"
                                        d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                                        clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="ml-3">
                                <h3 class="text-sm font-medium text-red-800">Booked Out</h3>
                                <p class="mt-1 text-sm text-red-700">{{ errors.venue_full }}</p>
                            </div>
                        </div>
                    </div>
                    <h2 class="mb-4 text-lg sm:text-xl font-semibold border-b pb-2">Guest Information</h2>

                    <!-- Honeypot field - hidden from users -->
                    <div style="position: absolute; left: -9999px; opacity: 0; pointer-events: none;">
                        <label for="rsvp_website">Website (leave blank)</label>
                        <input
                            v-model="rsvpForm.honeypot"
                            type="text"
                            id="rsvp_website"
                            name="website"
                            tabindex="-1"
                            autocomplete="off"
                        />
                    </div>

                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div>
                            <Label for="guest_name">Guest Name *</Label>
                            <Input id="guest_name" v-model="rsvpForm.guest_name" type="text" required
                                placeholder="Enter your fullname" :class="{ 'border-red-500': errors.guest_name }"
                                class="rounded pri-borders py-5 mt-1" />
                            <p v-if="errors.guest_name" class="mt-1 text-sm text-red-600">
                                {{ errors.guest_name }}
                            </p>
                        </div>
                        <div>
                            <div class="flex items-center justify-between">
                                <Label for="email">Email Address *</Label>
                                <div v-if="rsvpCheckingEmail" class="text-xs foreground/60 flex items-center">
                                    <svg class="animate-spin -ml-1 mr-1 h-3 w-3 foreground/60" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                    Checking...
                                </div>
                            </div>
                            <Input id="email" v-model="rsvpForm.email" type="email" required
                                placeholder="Enter your email"
                                :class="{
                                    'border-red-500': errors.email,
                                    'border-primary bg-card': isUpdatingRsvp
                                }"
                                class="rounded pri-borders py-5 mt-1" />
                            <p v-if="errors.email" class="mt-1 text-sm text-red-600">
                                {{ errors.email }}
                            </p>
                            <div v-if="isUpdatingRsvp && existingRsvp" class="mt-2 p-3 bg-blue-50 border border-blue-200 rounded-lg">
                                <div class="flex items-center">
                                    <svg class="w-4 h-4 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    <div class="text-sm">
                                        <p class="text-primary font-medium">Existing RSVP Found</p>
                                        <p class="text-primary/90">Registered on {{ existingRsvp?.created_at }}. You can update your information below.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div>
                            <Label for="phone">Phone Number</Label>
                            <Input id="phone" v-model="rsvpForm.phone" type="tel" placeholder="eg. 0240123456"
                                :class="{ 'border-red-500': errors.phone }" class="rounded pri-borders py-5 mt-1" />
                            <p v-if="errors.phone" class="mt-1 text-sm text-red-600">
                                {{ errors.phone }}
                            </p>
                        </div>
                        <div>
                            <Label for="referral_source" class="">How did you hear about
                                this event?</Label>
                            <Select v-model="rsvpForm.referral_source">
                                <SelectTrigger class=" w-full rounded pri-borders py-5 mt-1">
                                    <SelectValue placeholder="Select a source..." />
                                </SelectTrigger>

                                <SelectContent class="bg-background rounded pri-borders px-3 py-1 shadow-sm">
                                    <SelectGroup>
                                        <SelectLabel>Referral Sources</SelectLabel>
                                        <SelectItem v-for="option in referralOptions" :key="option" :value="option">
                                            {{ option }}
                                        </SelectItem>
                                    </SelectGroup>
                                </SelectContent>
                            </Select>
                            <p v-if="errors.referral_source" class="mt-1 text-sm text-red-600">
                                {{ errors.referral_source }}
                            </p>
                        </div>
                        <div class="sm:col-span-2">
                            <Label for="notes">Anything else you'd like us to know?</Label>
                            <Textarea placeholder="Anything we should know? Drop a note." maxlength="250"
                                v-model="rsvpForm.notes" class="rounded pri-borders py-3 mt-1" />
                        </div>

                    </div>

                    <!-- Custom form fields -->
                    <template v-if="event.form_fields && event.form_fields.length > 0">
                        <h2 class="text-lg sm:text-xl font-semibold border-b pb-2">Additional Information</h2>
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                            <template v-for="field in event.form_fields" :key="field.id">
                                <!-- Text input -->
                                <div v-if="field.field_type === 'text'" :class="{ 'sm:col-span-2': field.field_type === 'text' && !field.placeholder }">
                                    <Label :for="'field_' + field.id">
                                        {{ field.label }}<span v-if="field.is_required" class="text-red-500 ml-1">*</span>
                                    </Label>
                                    <Input
                                        :id="'field_' + field.id"
                                        v-model="rsvpForm.custom_fields[field.id] as string"
                                        type="text"
                                        :placeholder="field.placeholder || ''"
                                        :required="field.is_required"
                                        class="rounded pri-borders py-5 mt-1"
                                        :class="{ 'border-red-500': errors['custom_fields.' + field.id] }"
                                    />
                                    <p v-if="errors['custom_fields.' + field.id]" class="mt-1 text-sm text-red-600">
                                        {{ errors['custom_fields.' + field.id] }}
                                    </p>
                                </div>

                                <!-- Textarea -->
                                <div v-else-if="field.field_type === 'textarea'" class="sm:col-span-2">
                                    <Label :for="'field_' + field.id">
                                        {{ field.label }}<span v-if="field.is_required" class="text-red-500 ml-1">*</span>
                                    </Label>
                                    <Textarea
                                        :id="'field_' + field.id"
                                        v-model="rsvpForm.custom_fields[field.id] as string"
                                        :placeholder="field.placeholder || ''"
                                        :required="field.is_required"
                                        class="rounded pri-borders py-3 mt-1"
                                        :class="{ 'border-red-500': errors['custom_fields.' + field.id] }"
                                    />
                                    <p v-if="errors['custom_fields.' + field.id]" class="mt-1 text-sm text-red-600">
                                        {{ errors['custom_fields.' + field.id] }}
                                    </p>
                                </div>

                                <!-- Select / Dropdown -->
                                <div v-else-if="field.field_type === 'select'">
                                    <Label :for="'field_' + field.id">
                                        {{ field.label }}<span v-if="field.is_required" class="text-red-500 ml-1">*</span>
                                    </Label>
                                    <select
                                        :id="'field_' + field.id"
                                        v-model="rsvpForm.custom_fields[field.id]"
                                        :required="field.is_required"
                                        class="mt-1 w-full rounded pri-borders py-2 px-3 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-primary"
                                        :class="{ 'border-red-500': errors['custom_fields.' + field.id] }"
                                    >
                                        <option value="" disabled>Select an option...</option>
                                        <option v-for="opt in field.options" :key="opt.value" :value="opt.value">
                                            {{ opt.value }}
                                        </option>
                                    </select>
                                    <p v-if="errors['custom_fields.' + field.id]" class="mt-1 text-sm text-red-600">
                                        {{ errors['custom_fields.' + field.id] }}
                                    </p>
                                </div>

                                <!-- Radio buttons -->
                                <div v-else-if="field.field_type === 'radio'">
                                    <Label>
                                        {{ field.label }}<span v-if="field.is_required" class="text-red-500 ml-1">*</span>
                                    </Label>
                                    <div class="mt-2 space-y-2">
                                        <label v-for="opt in field.options" :key="opt.value" class="flex items-center gap-2 text-sm cursor-pointer">
                                            <input
                                                type="radio"
                                                :name="'field_' + field.id"
                                                :value="opt.value"
                                                v-model="rsvpForm.custom_fields[field.id]"
                                                :required="field.is_required"
                                                class="text-primary"
                                            />
                                            {{ opt.value }}
                                        </label>
                                    </div>
                                    <p v-if="errors['custom_fields.' + field.id]" class="mt-1 text-sm text-red-600">
                                        {{ errors['custom_fields.' + field.id] }}
                                    </p>
                                </div>

                                <!-- Checkboxes (multi-select) -->
                                <div v-else-if="field.field_type === 'checkbox'" class="sm:col-span-2">
                                    <Label>
                                        {{ field.label }}<span v-if="field.is_required" class="text-red-500 ml-1">*</span>
                                    </Label>
                                    <div class="mt-2 grid grid-cols-2 gap-2">
                                        <label v-for="opt in field.options" :key="opt.value" class="flex items-center gap-2 text-sm cursor-pointer">
                                            <input
                                                type="checkbox"
                                                :value="opt.value"
                                                v-model="rsvpForm.custom_fields[field.id]"
                                                class="text-primary rounded"
                                            />
                                            {{ opt.value }}
                                        </label>
                                    </div>
                                    <p v-if="errors['custom_fields.' + field.id]" class="mt-1 text-sm text-red-600">
                                        {{ errors['custom_fields.' + field.id] }}
                                    </p>
                                </div>
                            </template>
                        </div>
                    </template>

                    <div v-if="canSubmitRsvp" class="text-center">
                        <Button type="submit" size="lg" :disabled="rsvpProcessing"
                            class="rounded w-full py-5 cursor-pointer border bg-primary cursor-pointer sm:w-auto sm:px-6">
                            {{ rsvpProcessing ? 'Processing...' : (isUpdatingRsvp ? 'Update RSVP' : 'Secure Your Spot') }}
                        </Button>
                    </div>
                </form>
            </div>

            <!-- Social Links -->
            <div class="mb-2  bg-whites p-6 rounded">
                <h3 class="mb-4 text-xl font-semibold">Share this event</h3>
                <div class="flex flex-wrap gap-4">
                    <a :href="twitterShareUrl"
                        class=" rounded p-3 bg-card hover:bg-gray-50 transition-colors flex items-center justify-center"
                        target="_blank" rel="noopener" title="Share on Twitter">
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                            <path
                                d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z" />
                        </svg>
                    </a>
                    <a :href="facebookShareUrl"
                        class=" rounded p-3 bg-card hover:bg-gray-50 transition-colors flex items-center justify-center"
                        target="_blank" rel="noopener" title="Share on Facebook">
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                            <path
                                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                        </svg>
                    </a>
                    <a :href="linkedinShareUrl"
                        class=" rounded p-3 bg-card hover:bg-gray-50 transition-colors flex items-center justify-center"
                        target="_blank" rel="noopener" title="Share on LinkedIn">
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                            <path
                                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                        </svg>
                    </a>

                    <Button variant="default" @click="copyLink"
                        class="rounded-full cursor-pointer bg-primary hover:bg-primary/60 flex items-center gap-2 px-6">
                        <LinkIcon class="h-4 w-4" /> Copy Link
                    </Button>
                </div>
            </div>
            <!-- Tags -->

            <div v-if="event.tags && event.tags.length > 0" class="mb-2 rounded bg-whites p-6">

                <h2 class="mb-4 text-xl font-semibold">Tags</h2>
                <div class="flex flex-wrap gap-2">
                    <span v-for="tag in event.tags" :key="tag"
                        class="rounded bg-blue-50 hover:bg-blue-100 px-3 py-2 text-sm text-primary  transition-colors">
                        {{ tag }}
                    </span>
                </div>
            </div>

            <!-- Additional Info -->
            <div class="rounded lgb p-6">

                <h2 class="mb-4 text-xl font-semibold">Important Information</h2>
                <ul class="space-y-2 text-sm text-foreground/80">
                    <li class="flex items-start gap-2">
                        <span class="text-blue-500">•</span>
                        <span>Please arrive 15-30 minutes before the event starts</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-blue-500">•</span>
                        <span>Tickets are non-refundable unless the event is cancelled</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-blue-500">•</span>
                        <span>Valid ID may be required for entry</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="text-blue-500">•</span>
                        <span>Photography and recording policies may apply</span>
                    </li>
                </ul>
            </div>

        </section>
    </main>

    <!-- Report Issue Modal -->
    <Dialog v-model:open="showReportModal">
        <DialogContent class="sm:max-w-lg">
            <DialogHeader>
                <DialogTitle class="flex items-center gap-2">
                    <AlertTriangle class="w-5 h-5 text-red-600" />
                    Report Event Issue
                </DialogTitle>
                <DialogDescription>
                    Report an issue with <strong>{{ event.title }}</strong>. The event organizer will be notified.
                </DialogDescription>
            </DialogHeader>

            <div v-if="reportSuccess" class="text-center p-4">
                <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-green-100 mb-4">
                    <svg class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-foreground mb-2">Report Submitted Successfully!</h3>
                <p class="text-foreground/70">{{ reportMessage }}</p>
            </div>

            <form v-else @submit.prevent="submitReport" class="space-y-4">
                <!-- Honeypot field - hidden from users -->
                <div style="position: absolute; left: -9999px; opacity: 0; pointer-events: none;">
                    <label for="report_website">Website (leave blank)</label>
                    <input
                        v-model="reportForm.honeypot"
                        type="text"
                        id="report_website"
                        name="website"
                        tabindex="-1"
                        autocomplete="off"
                    />
                </div>

                <!-- Event Information -->
                <div class="lgb border border-primary/40 rounded-lg p-4">
                    <div class="flex items-start gap-3">
                        <div class="flex-shrink-0">
                            <svg class="w-5 h-5 text-primary/90 mt-0.5" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M8 7V3a1 1 0 011-1h6a1 1 0 011 1v4m-6 9l6-6m0 0v6m0-6H9" />
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-sm font-medium text-blue-900">Reporting issue for:</h4>
                            <p class="text-sm text-primary font-semibold mt-1">{{ event.title }}</p>
                            <p class="text-xs text-primary/90 mt-1">
                                {{ formatDate(event.start_date) }}
                                <span v-if="event.venue_name"> • {{ event.venue_name }}</span>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Reporter Info -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <Label for="reporter_name">Your Name</Label>
                        <Input id="reporter_name" v-model="reportForm.reporter_name"
                            :placeholder="$page.props.auth?.user?.name || 'Enter your name'" required />
                    </div>
                    <div>
                        <Label for="reporter_email">Your Email</Label>
                        <Input id="reporter_email" type="email" v-model="reportForm.reporter_email"
                            :placeholder="$page.props.auth?.user?.email || 'Enter your email'" required />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <Label for="report_type">Issue Type</Label>
                        <Select v-model="reportForm.report_type">
                            <SelectTrigger>
                                <SelectValue placeholder="Select issue type" />
                            </SelectTrigger>
                            <SelectContent>
                                <SelectItem value="bug">Technical Bug</SelectItem>
                                <SelectItem value="content_issue">Content Issue</SelectItem>
                                <SelectItem value="spam">Spam</SelectItem>
                                <SelectItem value="inappropriate">Inappropriate Content</SelectItem>
                                <SelectItem value="other">Other</SelectItem>
                            </SelectContent>
                        </Select>
                    </div>
                    <div>
                        <Label for="priority">Priority</Label>
                        <Select v-model="reportForm.priority">
                            <SelectTrigger>
                                <SelectValue placeholder="Select priority" />
                            </SelectTrigger>
                            <SelectContent>
                                <SelectItem value="low">Low</SelectItem>
                                <SelectItem value="medium">Medium</SelectItem>
                                <SelectItem value="high">High</SelectItem>
                                <SelectItem value="urgent">Urgent</SelectItem>
                            </SelectContent>
                        </Select>
                    </div>
                </div>

                <div>
                    <Label for="subject">Subject</Label>
                    <Input id="subject" v-model="reportForm.subject" placeholder="Brief description of the issue"
                        required />
                </div>

                <div>
                    <Label for="description">Description</Label>
                    <Textarea id="description" v-model="reportForm.description"
                        placeholder="Please provide detailed information about the issue..." class="min-h-[100px]"
                        required />
                </div>

                <DialogFooter class="gap-2">
                    <Button type="button" variant="outline" @click="showReportModal = false"
                        :disabled="reportSubmitting">
                        Cancel
                    </Button>
                    <Button type="submit" :disabled="reportSubmitting" class="bg-red-600 hover:bg-red-700">
                        <span v-if="reportSubmitting">Submitting...</span>
                        <span v-else>Submit Report</span>
                    </Button>
                </DialogFooter>
            </form>
        </DialogContent>
    </Dialog>

    <!-- Footer -->
    <Footer />
</template>

<script setup lang="ts">
import SeoHead from '@/components/SeoHead.vue';
import NavBar from '@/components/NavBar.vue';
import Footer from '@/components/Footer.vue';
